{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "6.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "iso-safe.js",
        "iso-features.js",
        "bridge2.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "safe.js",
        "features.js",
        "endpoints.js",
        "messages.js",
        "shared.js",
        "state.js",
        "hooks.js",
        "ui.js",
        "session.js",
        "quota.js",
        "network.js",
        "rpc-main.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "iso-messages.js",
        "iso-endpoints.js",
        "iso-shared.js",
        "conversation.js",
        "exporters.js",
        "zip.js",
        "pdf.js",
        "history.js",
        "charts.js",
        "handoff.js",
        "composer.js",
        "theme.js",
        "ui-kit.js",
        "client.js",
        "exporter.js",
        "recorder.js",
        "indexer.js",
        "handoff-ui.js",
        "panel.js",
        "placement.js",
        "welcome.js",
        "review.js",
        "feedback.js",
        "boot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "fonts/*"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ]
}